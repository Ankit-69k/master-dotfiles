#!/usr/bin/env bash

set -u

RICE="$HOME/my-rice"
GENERATED="$RICE/generated/current"
ACTIVE_WALLPAPER="$RICE/generated/ACTIVE_WALLPAPER"

# ─────────────────────────────────────
# Apply current wallpaper
# ─────────────────────────────────────

if [[ -f "$ACTIVE_WALLPAPER" ]]; then
  RICE_TRANSITION_TYPE=none "$RICE/scripts/wallpaper-current" >/tmp/wallpaper.log 2>&1
fi

# ─────────────────────────────────────
# Start Waybar
# ─────────────────────────────────────

if ! pgrep -x waybar >/dev/null; then
  waybar \
    -c "$GENERATED/config.jsonc" \
    -s "$GENERATED/style.css" \
    >/tmp/waybar.log 2>&1 &
fi

# ─────────────────────────────────────
# Start SwayNC
# ─────────────────────────────────────

if ! pgrep -x swaync >/dev/null; then
  swaync \
    -c "$GENERATED/swaync/config.json" \
    -s "$GENERATED/swaync/style.css" \
    >/tmp/swaync.log 2>&1 &
fi

# ─────────────────────────────────────
# Clipboard history
# ─────────────────────────────────────

wl-paste --type text --watch cliphist store &
