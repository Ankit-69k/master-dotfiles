#!/usr/bin/env bash

set -euo pipefail

RICE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

THEMES_DIR="$RICE_DIR/themes"
GENERATED_DIR="$RICE_DIR/generated"

ACTIVE_THEME_FILE="$GENERATED_DIR/ACTIVE_THEME"
ACTIVE_WALLPAPER_FILE="$GENERATED_DIR/ACTIVE_WALLPAPER"

# --------------------------------------------------
# Active theme
# --------------------------------------------------

if [[ ! -f "$ACTIVE_THEME_FILE" ]]; then
  echo "Error: no active theme."
  exit 1
fi

THEME="$(<"$ACTIVE_THEME_FILE")"
WALLPAPER_DIR="$THEMES_DIR/$THEME/wallpaper"

if [[ ! -d "$WALLPAPER_DIR" ]]; then
  echo "Error: wallpaper directory does not exist:"
  echo "$WALLPAPER_DIR"
  exit 1
fi

# --------------------------------------------------
# Find wallpapers
# --------------------------------------------------

mapfile -t WALLPAPERS < <(
  find "$WALLPAPER_DIR" -maxdepth 1 -type f \
    \( \
    -iname "*.png" \
    -o -iname "*.jpg" \
    -o -iname "*.jpeg" \
    -o -iname "*.webp" \
    -o -iname "*.gif" \
    -o -iname "*.mp4" \
    -o -iname "*.webm" \
    \) |
    sort
)

if [[ ${#WALLPAPERS[@]} -eq 0 ]]; then
  echo "Error: no wallpapers found in:"
  echo "$WALLPAPER_DIR"
  exit 1
fi

# --------------------------------------------------
# Select wallpaper
# --------------------------------------------------

MODE="${1:-random}"

case "$MODE" in

random)
  WALLPAPER="${WALLPAPERS[RANDOM % ${#WALLPAPERS[@]}]}"
  ;;

next)

  if [[ ! -f "$ACTIVE_WALLPAPER_FILE" ]]; then
    WALLPAPER="${WALLPAPERS[0]}"
  else
    CURRENT="$(<"$ACTIVE_WALLPAPER_FILE")"
    CURRENT_INDEX=-1

    for i in "${!WALLPAPERS[@]}"; do
      if [[ "${WALLPAPERS[$i]}" == "$CURRENT" ]]; then
        CURRENT_INDEX="$i"
        break
      fi
    done

    if ((CURRENT_INDEX < 0)); then
      WALLPAPER="${WALLPAPERS[0]}"
    else
      NEXT_INDEX=$(((CURRENT_INDEX + 1) % ${#WALLPAPERS[@]}))
      WALLPAPER="${WALLPAPERS[$NEXT_INDEX]}"
    fi
  fi
  ;;

*)
  if [[ -f "$MODE" ]]; then
    WALLPAPER="$(realpath "$MODE")"

  elif [[ -f "$WALLPAPER_DIR/$MODE" ]]; then
    WALLPAPER="$WALLPAPER_DIR/$MODE"

  else
    echo "Error: wallpaper not found:"
    echo "$MODE"
    exit 1
  fi
  ;;

esac

# --------------------------------------------------
# Validate
# --------------------------------------------------

if [[ ! -f "$WALLPAPER" ]]; then
  echo "Error: wallpaper does not exist:"
  echo "$WALLPAPER"
  exit 1
fi

EXT="${WALLPAPER##*.}"
EXT="${EXT,,}"


echo
echo "Theme:     $THEME"
echo "Wallpaper: $(basename "$WALLPAPER")"
echo "Type:      $EXT"
echo

# --------------------------------------------------
# Animated wallpapers
# --------------------------------------------------

case "$EXT" in

mp4 | webm)

  echo "Starting mpvpaper..."

  # Stop only mpvpaper when switching to animated wallpaper
  pkill -x mpvpaper 2>/dev/null || true

  mpvpaper \
    -o "no-audio --loop-file=inf" \
    '*' \
    "$WALLPAPER" \
    >/tmp/mpvpaper.log 2>&1 &

  echo "✓ Animated wallpaper applied."
  ;;

  # --------------------------------------------------
  # Static wallpapers
  # --------------------------------------------------

png | jpg | jpeg | webp | gif)

  if ! command -v awww >/dev/null || ! command -v awww-daemon >/dev/null; then
    echo "Error: awww and awww-daemon are required for wallpaper transitions." >&2
    exit 1
  fi

  # Keep the daemon alive across switches so it can animate from the old image.
  started=false
  if ! awww query >/dev/null 2>&1; then
    if ! pgrep -x awww-daemon >/dev/null; then
      nohup awww-daemon >/tmp/awww.log 2>&1 </dev/null &
    fi
    started=true
    ready=false
    for _ in {1..50}; do
      if awww query >/dev/null 2>&1; then
        ready=true
        break
      fi
      sleep 0.1
    done
    if [[ "$ready" != true ]]; then
      echo "Error: awww did not become ready; see /tmp/awww.log." >&2
      exit 1
    fi
  fi

  # Seed a newly started daemon with the previous image before the reveal.
  # This also handles the one-time migration from Hyprpaper.
  if [[ "$started" == true && -f "$ACTIVE_WALLPAPER_FILE" ]]; then
    previous="$(<"$ACTIVE_WALLPAPER_FILE")"
    case "${previous,,}" in
      *.png | *.jpg | *.jpeg | *.webp | *.gif)
        if [[ -f "$previous" ]]; then
          awww img "$previous" --transition-type none
        fi
        ;;
    esac
  fi

  awww img "$WALLPAPER" \
    --transition-type "${RICE_TRANSITION_TYPE:-grow}" \
    --transition-pos center \
    --transition-duration 0.8 \
    --transition-fps 60

  # Retire the old backend only after awww has accepted the replacement.
  pkill -x hyprpaper 2>/dev/null || true
  pkill -x mpvpaper 2>/dev/null || true

  echo "✓ Wallpaper applied."
  ;;

*)

  echo "Error: unsupported wallpaper format: .$EXT"
  exit 1
  ;;

esac

printf '%s\n' "$WALLPAPER" >"$ACTIVE_WALLPAPER_FILE"

echo
echo "Active wallpaper:"
echo "$WALLPAPER"
echo
