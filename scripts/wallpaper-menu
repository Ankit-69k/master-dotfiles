#!/usr/bin/env bash

set -euo pipefail

RICE="$HOME/my-rice"
THEME="$(cat "$RICE/generated/ACTIVE_THEME")"
DIR="$RICE/themes/$THEME/wallpaper"

SELECTED="$(
  find "$DIR" -maxdepth 1 -type f \
    \( \
    -iname "*.png" \
    -o -iname "*.jpg" \
    -o -iname "*.jpeg" \
    -o -iname "*.webp" \
    -o -iname "*.gif" \
    \) \
    -print0 |
    while IFS= read -r -d '' file; do
      printf '%s\0icon\x1f%s\n' "$(basename "$file")" "$file"
    done |
    rofi \
      -dmenu \
      -show-icons \
      -p "Wallpaper" \
      -theme "$RICE/generated/current/theme.rasi" |
    tr -d '\0'
)"

if [ -z "$SELECTED" ]; then
  exit 0
fi

"$RICE/scripts/wallpaper" "$DIR/$SELECTED"
