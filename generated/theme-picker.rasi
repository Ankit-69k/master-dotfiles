* {
    background:     #282828;
    background-alt: #3c3836;
    foreground:     #ebdbb2;
    accent:         #fe8019;

    background-color: @background;
    text-color: @foreground;

    font: "JetBrainsMono Nerd Font 11";
}

window {
    width: 75%;
    height: 70%;

    background-color: @background;

    border: 2px;
    border-color: @accent;
    border-radius: 12px;

    padding: 20px;
}

mainbox {
    background-color: transparent;

    children: [ inputbar, listview ];

    spacing: 18px;
}

inputbar {
    background-color: @background-alt;

    border-radius: 8px;
    padding: 12px 16px;

    children: [ prompt, entry ];

    spacing: 10px;
}

prompt {
    text-color: @accent;
    font: "JetBrainsMono Nerd Font 11 bold";
}

entry {
    text-color: @foreground;
    placeholder: "Search themes...";
    placeholder-color: #ffffff66;
}

listview {
    background-color: transparent;

    columns: 2;
    lines: 3;

    spacing: 16px;

    fixed-height: false;
    dynamic: true;
    scrollbar: false;
}

element {
    background-color: @background-alt;

    orientation: vertical;

    padding: 12px;
    spacing: 10px;

    border-radius: 10px;

    text-color: @foreground;
}

element normal {
    background-color: @background-alt;
    text-color: @foreground;
}

element selected {
    background-color: @accent;

    border: 2px;
    border-color: @accent;

    text-color: @background;
}

element-icon {
    size: 280px;

    horizontal-align: 0.5;
    vertical-align: 0.5;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;

    text-color: inherit;
}
