/* AUTO-GENERATED — theme: rose-pine */

* {
    background:     #191724;
    background-alt: #1f1d2e;
    foreground:     #e0def4;
    accent:         #c4a7e7;
    urgent:         #eb6f92;

    background-color: @background;
    text-color:       @foreground;
    font:             "JetBrainsMono Nerd Font 11";
}

window {
    width:            30%;
    border-radius:    10px;
    border:           2px;
    border-color:     #c4a7e755;
    padding:          16px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 14px;
}

inputbar {
    background-color: @background-alt;
    border-radius:    10px;
    padding:          10px 14px;
    children:         [ prompt, entry ];
    spacing:          8px;
}

prompt {
    text-color: @accent;
    font:       "JetBrainsMono Nerd Font 11 bold";
}

entry {
    placeholder:       "Search apps…";
    placeholder-color: #e0def466;
    text-color:        @foreground;
}

listview {
    lines:        8;
    spacing:      5px;
    scrollbar:    false;
    fixed-height: false;
    dynamic:      true;
}

element {
    padding:          9px 12px;
    border-radius:    calc(10px - 2px);
    spacing:          10px;
    background-color: transparent;
    text-color:        @foreground;
}

element normal {
    background-color: transparent;
    text-color:        #e0def4cc;
}

element selected {
    background-color: #c4a7e718;
    text-color:        @foreground;
    border:            1px;
    border-color:      #c4a7e755;
}

element-icon {
    size:            26px;
    vertical-align:  0.5;
}

element-text {
    vertical-align: 0.5;
    text-color:     inherit;
}
