/* AUTO-GENERATED — theme: {{theme_name}} */

* {
    background:     #{{background}};
    background-alt: #{{background_alt}};
    foreground:     #{{foreground}};
    accent:         #{{accent}};
    urgent:         #{{red}};

    background-color: @background;
    text-color:       @foreground;
    font:             "{{font}} 11";
}

window {
    width:            30%;
    border-radius:    {{border_radius}}px;
    border:           {{border_width}}px;
    border-color:     #{{accent}}55;
    padding:          16px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 14px;
}

inputbar {
    background-color: @background-alt;
    border-radius:    {{border_radius}}px;
    padding:          10px 14px;
    children:         [ prompt, entry ];
    spacing:          8px;
}

prompt {
    text-color: @accent;
    font:       "{{font}} 11 bold";
}

entry {
    placeholder:       "Search apps…";
    placeholder-color: #{{foreground}}66;
    text-color:        @foreground;
}

listview {
    lines:        8;
    spacing:      5px;
    scrollbar:    false;
    fixed-height: false;
    dynamic:      true;
}

element {
    padding:          9px 12px;
    border-radius:    calc({{border_radius}}px - 2px);
    spacing:          10px;
    background-color: transparent;
    text-color:        @foreground;
}

element normal {
    background-color: transparent;
    text-color:        #{{foreground}}cc;
}

element selected {
    background-color: #{{accent}}18;
    text-color:        @foreground;
    border:            1px;
    border-color:      #{{accent}}55;
}

element-icon {
    size:            26px;
    vertical-align:  0.5;
}

element-text {
    vertical-align: 0.5;
    text-color:     inherit;
}
