* {
    background:     #282828;
    background-alt: #3c3836;
    foreground:     #ebdbb2;
    accent:         #fe8019;

    background-color: @background;
    text-color:       @foreground;

    font: "JetBrainsMono Nerd Font 11";
}

window {
    width: 70%;
    height: 70%;

    border: 2px;
    border-color: #fe801955;
    border-radius: 8px;

    padding: 20px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 16px;
}

inputbar {
    background-color: @background-alt;
    border-radius: 6px;
    padding: 12px 16px;

    children: [ prompt, entry ];
    spacing: 10px;
}

prompt {
    text-color: @accent;
    font: "JetBrainsMono Nerd Font 11 bold";
}

entry {
    placeholder: "Search…";
    placeholder-color: #ebdbb266;
    text-color: @foreground;
}

listview {
    columns: 2;
    lines: 3;

    spacing: 12px;
    scrollbar: false;
    fixed-height: false;
    dynamic: true;
}

element {
    orientation: vertical;

    padding: 10px;
    border-radius: 6px;
    spacing: 8px;

    background-color: transparent;
}

element normal {
    background-color: transparent;
    text-color: #ebdbb2cc;
}

element selected {
    background-color: #fe801918;

    border: 2px;
    border-color: #fe801955;

    text-color: @foreground;
}

element-icon {
    size: 180px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    text-color: inherit;
}
