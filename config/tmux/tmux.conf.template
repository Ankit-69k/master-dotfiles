# ─────────────────────────────────────
# Kora Rice - tmux
# ─────────────────────────────────────

# Prefix
unbind C-b
set -g prefix C-Space
bind C-Space send-prefix

# Better indexing
set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on

# Mouse
set -g mouse on

# True color
set -g default-terminal "tmux-256color"
set -as terminal-features ",xterm-256color:RGB"

# Faster escape
set -sg escape-time 10

# Vim-style pane navigation
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R

# Split panes
bind | split-window -h
bind - split-window -v

# Keep current directory
bind c new-window -c "#{pane_current_path}"
bind '"' split-window -v -c "#{pane_current_path}"
bind % split-window -h -c "#{pane_current_path}"

# Reload config
bind r source-file ~/.config/tmux/tmux.conf \; display-message "tmux config reloaded"

# Status bar
set -g status-position bottom
set -g status-interval 1

# Window names
setw -g automatic-rename on
setw -g automatic-rename-format '#{b:pane_current_path}'

# Don't destroy tmux when last session closes
set -g detach-on-destroy off

# ─────────────────────────────────────
# Theme
# ─────────────────────────────────────

set -g status-style "bg={{background}},fg={{foreground}}"
set -g window-status-style "bg={{background}},fg={{foreground}}"
set -g window-status-current-style "bg={{accent}},fg={{background}},bold"
set -g pane-border-style "fg={{background_alt}}"
set -g pane-active-border-style "fg={{accent}}"

set -g message-style "bg={{accent}},fg={{background}}"

set -g status-left-length 30
set -g status-left "#[bold] #S "

set -g status-right-length 50
set -g status-right "#[fg={{foreground}}] %H:%M  %d-%m-%Y "

setw -g window-status-format " #I:#W "
setw -g window-status-current-format " #I:#W "
