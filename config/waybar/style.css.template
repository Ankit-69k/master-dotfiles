/* AUTO-GENERATED — theme: {{theme_name}} */

* {
    font-family: "{{font}}";
    font-size: {{font_size}}px;
    min-height: 0;
}

window#waybar {
    background-color: transparent;
    color: #{{foreground}};
}

/* Group backgrounds */
.modules-left,
.modules-right,
.modules-center {
    margin: 4px;
    padding: 4px 10px;
    background: #{{background_alt}};
    border-radius: {{border_radius}}px;
}

/* Clock */
#clock {
    color: #{{foreground}};
    font-weight: bold;
}

/* Arch icon */
#custom-arch {
    color: #{{accent}};
    font-size: 16px;
}

/* Workspaces */
#workspaces button {
    padding: 0 3px;
    color: #{{comment}};
    background: transparent;
    border: none;
    font-size: 16px;
}

#workspaces button:not(.empty) {
    color: #{{foreground}};
}

#workspaces button.active {
    color: #{{foreground}};
}

#workspaces button:not(.active):not(.empty) {
    color: #{{accent}};
}

#workspaces button:hover {
    color: #{{foreground}};
}

/* Right-side icons */
#temperature,
#cpu,
#memory,
#custom-screen-record,
#network,
#bluetooth,
#pulseaudio,
#battery,
#custom-power {
    font-size: 12px;
}

/* Weather */
#custom-weather {
    color: #{{yellow}};
}

/* Battery */
#battery.warning {
    color: #{{yellow}};
}

#battery.critical {
    color: #{{red}};
}

/* Network */
#network.disconnected {
    color: #{{red}};
}

/* Bluetooth */
#bluetooth.off {
    color: #{{comment}};
}
